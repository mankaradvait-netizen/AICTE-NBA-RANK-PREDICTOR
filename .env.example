# ==============================================================================
# NIRF DETERMINISTIC PLATFORM ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

APP_ENV=production
APP_DEBUG=0

# Generate both cryptographic keys independently with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=nirf.deterministic.internal
JWT_AUDIENCE=nirf.api.clients
JWT_EXPIRATION_SECONDS=900

MASTER_KEY_HEX=
ACTIVE_KEY_ID=key-initial
# CRYPTO_MODE: 'gcm' (default AES-256-GCM) or 'cbc_hmac' (AES-256-CBC with HMAC-SHA256 Encrypt-then-MAC)
CRYPTO_MODE=gcm

# Database 1: NIRF Formula Engine DB (Formulas, Benchmarks, Rules)
# Scoring uses read-only credentials; Formula Admin uses admin credentials
DB_FORMULA_READER_DSN=pgsql:host=nirf_postgres;port=5432;dbname=nirf_formula_engine_db
DB_FORMULA_READER_USER=nirf_formula_reader
DB_FORMULA_READER_PASSWORD=

DB_FORMULA_ADMIN_DSN=pgsql:host=nirf_postgres;port=5432;dbname=nirf_formula_engine_db
DB_FORMULA_ADMIN_USER=nirf_formula_admin
DB_FORMULA_ADMIN_PASSWORD=

# Database 2: NIRF Institution Core DB (Users, Auth, Submissions, Audit Logs)
DB_CORE_DSN=pgsql:host=nirf_postgres;port=5432;dbname=nirf_institution_core_db
DB_CORE_USER=nirf_institution_app
DB_CORE_PASSWORD=

# Postgres initialization password; use a unique generated secret
POSTGRES_PASSWORD=

# Storage Directory for Uploaded & Generated Spreadsheets (outside webroot)
STORAGE_DIR=/var/nirf/storage

# Security & CORS (strict allowlist, comma-separated, NO wildcards)
CORS_ALLOWED_ORIGINS=https://portal.institution.ac.in,https://iqac.nirf.ac.in
COOKIE_SECURE=1

# Multimodal AI Strategy (Google Gemini)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
