{
  "name": "nirf/deterministic-engine",
  "description": "Deterministic NIRF Analysis Platform Backend with Dual PostgreSQL, Excel-Driven Formulas and Defense-in-Depth Security",
  "type": "project",
  "license": "Proprietary",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-sodium": "*",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "symfony/expression-language": "^7.1",
    "phpoffice/phpspreadsheet": "^2.3",
    "firebase/php-jwt": "^7.0",
    "spomky-labs/otphp": "^11.3",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.7",
    "respect/validation": "^2.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse --level=8 src"
  }
}
